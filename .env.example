DB_HOST=localhost
DB_PORT=5432
DB_NAME=airline_db
DB_USER=airline_app
DB_PASSWORD=change-me
DB_POOL_MIN=20
DB_POOL_MAX=60
CORS_ORIGINS=http://localhost:5500

# Local: postgres. AWS: athena
ANALYTICS_BACKEND=postgres
AWS_REGION=us-east-1
ATHENA_DATABASE=airline_analytics
ATHENA_METRICS_TABLE=route_month_metrics
ATHENA_OUTPUT_LOCATION=s3://your-athena-query-results/
ATHENA_TIMEOUT_SECONDS=8

# Parcial 3 streaming services; use the existing EC2 instance profile, not static keys.
KINESIS_STREAM_NAME=
KINESIS_PUBLISH_TIMEOUT_SECONDS=1
KINESIS_PUBLISH_WORKERS=16
RAW_EVENTS_URI=
GLUE_STAR_JOB_NAME=
ATHENA_STAR_DATABASE=
